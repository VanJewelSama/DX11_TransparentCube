  <!-- 把运行期资源复制到 exe 旁边：双击 x64\Debug\TransparentCube.exe 时也能找到 shader/贴图 -->
  <Target Name="CopyRuntimeContent" AfterTargets="Build">
    <ItemGroup>
      <ShaderFiles Include="$(ProjectDir)shaders\**\*.*" />
      <AssetFiles  Include="$(ProjectDir)assets\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ShaderFiles)"
          DestinationFolder="$(OutDir)shaders\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)"
          DestinationFolder="$(OutDir)assets\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(AssetFiles)' != ''" />
  </Target>
